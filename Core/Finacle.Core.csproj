<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputPath>bin\Release</OutputPath>
    <Version>1.1.19 </Version>
    <Authors>Sylvanus Quarm, Ofoe Hadjoe</Authors>
    <Company>GTBank Ghana</Company>
    <Description>
      A Finacle .NET client library for Core Banking Integrations.
      It Contains Transaction, Customer, Account, and other Finacle API clients.
    </Description>
    <PackageTags>your;tags;here</PackageTags>
    <RepositoryUrl>https://devops.gtbghana.com/DevOps/APIs/Finacle%20Integrations</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="9.0.4" />
  </ItemGroup>

</Project>

