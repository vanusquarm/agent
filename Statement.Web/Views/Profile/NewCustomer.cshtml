@model Statement.Web.Models.NewCustomerDto

@{
    ViewData["Title"] = "New Customer - GT Bank Ghana";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex items-center gap-3 mb-8">
        <div class="w-12 h-12 gt-orange-bg rounded-full flex items-center justify-center">
            <i class="fas fa-user-plus text-white text-xl"></i>
        </div>
        <div>
            <h2 class="text-3xl font-bold text-gray-800">New Customer</h2>
            <p class="text-gray-500 text-sm">Add a new customer to the statement delivery system</p>
        </div>
    </div>

    <!-- Error Message -->
    <div id="error-message" class="hidden bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg">
        <div class="flex items-center">
            <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
            <span class="text-red-700" id="error-text"></span>
        </div>
    </div>

    <!-- Success Message -->
    @if (!string.IsNullOrEmpty(ViewBag.SuccessMessage))
    {
        <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-6 rounded-r-lg">
            <div class="flex items-center">
                <i class="fas fa-check-circle text-green-500 mr-3"></i>
                <span class="text-green-700">@ViewBag.SuccessMessage</span>
            </div>
        </div>
    }

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <!-- Header -->
        <div class="gt-orange-bg px-8 py-6">
            <h3 class="text-white text-xl font-semibold flex items-center">
                <i class="fas fa-edit mr-3"></i> Customer Information
            </h3>
        </div>

        <!-- Search Section -->
        <div class="p-8 border-b border-gray-100">
            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                <i class="fas fa-search text-orange-500 mr-2"></i> Search Customer by Account Number
            </label>
            <div class="flex gap-3">
                <input type="text" id="searchCustomerNumber" 
                       class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                       placeholder="Enter account number to auto-fill details">
                <button id="searchCustomerBtn" 
                        class="gt-orange-bg text-white px-6 py-3 rounded-xl font-semibold hover:bg-orange-600 transition-all flex items-center gap-2 min-w-[120px] justify-center">
                    <span class="button-text"><i class="fas fa-search mr-2"></i>Search</span>
                    <span class="button-loader hidden"><i class="fas fa-spinner fa-spin"></i> Searching...</span>
                </button>
            </div>
            <p class="text-xs text-gray-400 mt-2">
                <i class="fas fa-info-circle mr-1"></i> Search will auto-populate customer details
            </p>
        </div>

        <!-- Form -->
        <form id="newCustomerForm" method="post" action="@Url.Action("SaveNewCustomer", "Profile")" class="p-8">
            @Html.AntiForgeryToken()

            <!-- Hidden Fields -->
            <input type="hidden" name="Frequency.DailyOpt" value="-1" />
            <input type="hidden" name="Frequency.WeeklyOpt" value="-1" />
            <input type="hidden" name="Frequency.MonthlyOpt" value="-1" />
            <input type="hidden" name="Frequency.ContinuousOpt" value="-1" />
            <input type="hidden" name="Frequency.ContinuousPerMonth" value="0" />
            <input type="hidden" name="CustomerNumber" id="customerNumber" value="@Model.CustomerNumber" />

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Branch -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-building text-orange-500 mr-2"></i> Branch
                    </label>
                    <input type="text" id="branch" name="Branch" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed"
                           value="@Model.Branch" readonly>
                </div>

                <!-- CIF ID -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-id-card text-orange-500 mr-2"></i> CIF ID
                    </label>
                    <input type="text" id="cif_id" name="CIF_ID" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed"
                           value="@Model.CIF_ID" readonly>
                </div>

                <!-- Customer Name -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-user text-orange-500 mr-2"></i> Customer Name
                    </label>
                    <input type="text" id="customerName" name="CustomerName" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed"
                           value="@Model.CustomerName" readonly>
                </div>

                <!-- Email -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-envelope text-orange-500 mr-2"></i> Email Address
                    </label>
                    <input type="email" id="email" name="Email" 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                           value="@Model.Email" placeholder="customer@email.com">
                </div>

                <!-- Accounts -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-list text-orange-500 mr-2"></i> Accounts
                    </label>
                    <select id="accounts" name="Accounts" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed" multiple disabled>
                        @if (Model.Accounts != null)
                        {
                            foreach (var account in Model.Accounts)
                            {
                                <option value="@account.AccountIdentification">@account.AccountName - @account.AccountCurrency</option>
                            }
                        }
                    </select>
                </div>

                <!-- Output Format -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-file-export text-orange-500 mr-2"></i> Output Format
                    </label>
                    <select id="defaultExt" name="DefaultExt" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all">
                        <option value="pdf" selected="@(Model?.DefaultExt == "pdf")">PDF</option>
                        <option value="xls" selected="@(Model?.DefaultExt == "xls")">Excel</option>
                    </select>
                </div>

                <!-- Statement Frequency -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-calendar-alt text-orange-500 mr-2"></i> Statement Frequency
                    </label>
                    <div class="space-y-2">
                        <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                            <input type="checkbox" name="Frequency.Daily" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.Frequency.Daily ? "checked" : "")>
                            <span class="ml-3 text-gray-700">Daily</span>
                        </label>
                        <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                            <input type="checkbox" name="Frequency.Weekly" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.Frequency.Weekly ? "checked" : "")>
                            <span class="ml-3 text-gray-700">Weekly</span>
                        </label>
                        <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                            <input type="checkbox" name="Frequency.Monthly" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.Frequency.Monthly ? "checked" : "")>
                            <span class="ml-3 text-gray-700">Monthly</span>
                        </label>
                    </div>
                </div>

                <!-- Additional Options -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-cog text-orange-500 mr-2"></i> Additional Options
                    </label>
                    <div class="space-y-2">
                        <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                            <input type="checkbox" id="allAccounts" name="AllAccounts" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.Allaccounts ? "checked" : "")>
                            <span class="ml-3 text-gray-700">Send statements for all accounts</span>
                        </label>
                        <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                            <input type="checkbox" id="useExportFile" name="UseExportFile" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.UseExportFile ? "checked" : "")>
                            <span class="ml-3 text-gray-700">Use export file</span>
                        </label>
                        <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                            <input type="checkbox" id="continuous" name="Frequency.Continuous" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.Frequency.Continuous ? "checked" : "")>
                            <span class="ml-3 text-gray-700">Enable Continuous Statements</span>
                        </label>
                    </div>
                </div>

                <!-- Regenerate Daily Statement -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-redo text-orange-500 mr-2"></i> Regenerate Daily Statement
                    </label>
                    <div class="flex gap-4 p-3 border border-gray-200 rounded-xl">
                        <label class="flex items-center cursor-pointer">
                            <input type="radio" id="regenerateYes" name="RegenerateDailyStmt" value="1" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.RegenerateDailyStmt == 1 ? "checked" : "") required>
                            <span class="ml-2 text-gray-700">Yes</span>
                        </label>
                        <label class="flex items-center cursor-pointer">
                            <input type="radio" id="regenerateNo" name="RegenerateDailyStmt" value="0" class="w-4 h-4 text-orange-500 focus:ring-orange-200" @(Model.RegenerateDailyStmt == 0 ? "checked" : "") required>
                            <span class="ml-2 text-gray-700">No</span>
                        </label>
                    </div>
                </div>

                <!-- Status -->
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                        <i class="fas fa-info-circle text-orange-500 mr-2"></i> Status
                    </label>
                    <select id="status" name="Status" 
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all" required>
                        <option value="Yes" selected="@(Model?.Status == "Yes")">Active</option>
                        <option value="No" selected="@(Model?.Status == "No")">Inactive</option>
                    </select>
                </div>
            </div>

            <!-- Submit Button -->
            <div class="mt-8 flex justify-center">
                <button type="submit" 
                        class="gt-orange-bg text-white px-12 py-3.5 rounded-xl font-semibold hover:bg-orange-600 transition-all flex items-center gap-3 min-w-[200px] justify-center shadow-lg hover:shadow-orange-200/50">
                    <span class="button-text"><i class="fas fa-check mr-2"></i> Save Customer</span>
                    <span class="button-loader hidden"><i class="fas fa-spinner fa-spin"></i> Saving...</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal">
    <div class="modal-content">
        <div class="p-6 border-b flex justify-between items-center">
            <h3 class="text-xl font-semibold text-green-600 flex items-center">
                <i class="fas fa-check-circle mr-2"></i> Success!
            </h3>
            <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
        </div>
        <div class="p-6">
            <p id="modalMessage" class="text-gray-700">Customer information saved successfully.</p>
        </div>
        <div class="p-6 border-t flex justify-end">
            <button class="close-modal px-6 py-3 gt-orange-bg text-white rounded-xl font-semibold hover:bg-orange-600 transition">
                Close
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/save_customer.js" type="text/javascript"></script>
}