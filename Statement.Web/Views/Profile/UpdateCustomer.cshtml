@model Statement.Web.Models.NewCustomerDto
@{
    ViewData["Title"] = "Update Customer - GT Bank Ghana";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.7);
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        width: 90%;
        max-width: 520px;
        max-height: 90vh;
        overflow-y: auto;
    }
</style>
<div class="max-w-7xl mx-auto px-6 py-10">
    <div class="flex items-center gap-3 mb-8">
        <div class="w-12 h-12 gt-orange-bg rounded-full flex items-center justify-center">
            <i class="fas fa-user-edit text-white text-xl"></i>
        </div>
        <div>
            <h2 class="text-3xl font-bold text-gray-800">Update Customer</h2>
            <p class="text-gray-500 text-sm">Update customer information and preferences</p>
        </div>
    </div>

    <!-- Error Message -->
    <div id="error-message" class="hidden bg-red-50 border-l-4 border-red-500 p-4 mb-6 rounded-r-lg">
        <div class="flex items-center">
            <i class="fas fa-exclamation-circle text-red-500 mr-3"></i>
            <span class="text-red-700" id="error-text"></span>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
        <!-- Header -->
        <div class="gt-orange-bg px-8 py-6">
            <h3 class="text-white text-xl font-semibold flex items-center">
                <i class="fas fa-search mr-3"></i> Search Customer
            </h3>
        </div>

        <!-- Search Section -->
        <div class="p-8 border-b border-gray-100">
            <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                <i class="fas fa-id-card text-orange-500 mr-2"></i> Enter CIF ID
            </label>
            <div class="flex gap-3">
                <input type="text" id="searchCustomerNumber"
                       class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                       placeholder="Enter CIF ID to load customer data"
                       value="@(Model?.CIF_ID ?? "")">
                <button id="searchCustomerBtn"
                        class="gt-orange-bg text-white px-6 py-3 rounded-xl font-semibold hover:bg-orange-600 transition-all flex items-center gap-2 min-w-[120px] justify-center">
                    <span class="button-text"><i class="fas fa-search mr-2"></i>Search</span>
                    <span class="button-loader hidden"><i class="fas fa-spinner fa-spin"></i> Searching...</span>
                </button>
            </div>
            <p class="text-xs text-gray-400 mt-2">
                <i class="fas fa-info-circle mr-1"></i> Search will load existing customer data for editing
            </p>
        </div>

        <!-- Form Section - Hidden by default, shown after search -->
        <div id="formSection" style="display: @(Model?.CIF_ID != null ? "block" : "none");">
            <form id="updateCustomerForm" method="post" action="@Url.Action("UpdateCustomer", "Profile")" class="p-8">
                @Html.AntiForgeryToken()

                <!-- Hidden Fields -->
                <input type="hidden" name="ID" id="ID" value="@Model?.ID" />
                <input type="hidden" name="Branch" id="branch" value="@Model?.Branch" />
                <input type="hidden" name="CustomerNumber" id="customerNumber" value="@Model?.CustomerNumber" />
                <input type="hidden" name="CustomerName" id="customerName" value="@Model?.CustomerName" />
                <input type="hidden" name="CIF_ID" id="cif_id" value="@Model?.CIF_ID" />
                <input type="hidden" name="ExportFile" value="" />
                <input type="hidden" name="ReportFile" value="" />
                <input type="hidden" name="ExportFormat" value="" />
                <input type="hidden" name="Createdby" value="@Model?.Createdby" />
                <input type="hidden" name="datecreated" value="@Model?.datecreated" />
                <input type="hidden" name="lastupdatedby" id="lastupdatedby" value="@Model?.lastupdatedby" />
                <input type="hidden" name="lastupdateddate" value="@Model?.lastupdateddate" />
                <input type="hidden" name="ContinuousPerMonth" value="@Model?.Frequency?.ContinuousPerMonth" />
                <input type="hidden" name="Allaccounts" id="allAccounts" value="@Model?.Allaccounts.ToString()" />
                <input type="hidden" name="UseExportFile" id="useExportFile" value="@Model?.UseExportFile.ToString()" />
                <input type="hidden" name="NoofDays" value="" />

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Non-editable fields -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-building text-orange-500 mr-2"></i> Branch
                        </label>
                        <input type="text" class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed"
                               value="@Model?.Branch" readonly>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-id-card text-orange-500 mr-2"></i> CIF ID
                        </label>
                        <input type="text" class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed"
                               value="@Model?.CIF_ID" readonly>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-user text-orange-500 mr-2"></i> Customer Name
                        </label>
                        <input type="text" class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed"
                               value="@Model?.CustomerName" readonly>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-list text-orange-500 mr-2"></i> Accounts
                        </label>
                        <select class="w-full px-4 py-3 border border-gray-300 rounded-xl bg-gray-50 cursor-not-allowed" multiple disabled>
                            @if (Model?.Accounts != null && Model.Accounts.Any())
                            {
                                foreach (var account in Model.Accounts)
                                {
                                    <option value="@account.AccountIdentification">@account.AccountIdentification - @account.AccountCurrency</option>
                                }
                            }
                            else
                            {
                                <option value="">No accounts found</option>
                            }
                        </select>
                    </div>

                    <!-- Editable fields -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-envelope text-orange-500 mr-2"></i> Email Address
                        </label>
                        <input type="text" id="email" name="Email"
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                               value="@Model?.Email" placeholder="customer@email.com">
                        <p class="text-xs text-gray-400 mt-1">Separate multiple emails with semicolon (;)</p>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-file-export text-orange-500 mr-2"></i> Output Format
                        </label>
                        <select id="defaultExt" name="DefaultExt"
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all">
                            <option value="pdf" selected="@(Model?.DefaultExt == "pdf")">PDF</option>
                            <option value="xls" selected="@(Model?.DefaultExt == "xls")">Excel</option>
                        </select>
                    </div>

                    <!-- Statement Frequency -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-calendar-alt text-orange-500 mr-2"></i> Statement Frequency
                        </label>
                        <div class="space-y-2">
                            <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                                <input type="checkbox" name="Frequency.Daily" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.Frequency?.Daily == true)">
                                <span class="ml-3 text-gray-700">Daily</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                                <input type="checkbox" name="Frequency.Weekly" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.Frequency?.Weekly == true)">
                                <span class="ml-3 text-gray-700">Weekly</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                                <input type="checkbox" name="Frequency.Monthly" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.Frequency?.Monthly == true)">
                                <span class="ml-3 text-gray-700">Monthly</span>
                            </label>
                        </div>
                    </div>

                    <!-- Additional Options -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-cog text-orange-500 mr-2"></i> Additional Options
                        </label>
                        <div class="space-y-2">
                            <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                                <input type="checkbox" name="AllAccounts" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.Allaccounts == true)">
                                <span class="ml-3 text-gray-700">Send statements for all accounts</span>
                            </label>
                            <label class="flex items-center p-3 border border-gray-200 rounded-xl hover:bg-orange-50 transition cursor-pointer">
                                <input type="checkbox" name="UseExportFile" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.UseExportFile == true)">
                                <span class="ml-3 text-gray-700">Use export file</span>
                            </label>
                        </div>
                    </div>

                    <!-- Regenerate Daily Statement -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-redo text-orange-500 mr-2"></i> Regenerate Daily Statement
                        </label>
                        <div class="flex gap-4 p-3 border border-gray-200 rounded-xl">
                            <label class="flex items-center cursor-pointer">
                                <input type="radio" id="regenerateYes" name="RegenerateDailyStmt" value="1" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.RegenerateDailyStmt == 1)" required>
                                <span class="ml-2 text-gray-700">Yes</span>
                            </label>
                            <label class="flex items-center cursor-pointer">
                                <input type="radio" id="regenerateNo" name="RegenerateDailyStmt" value="0" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.RegenerateDailyStmt == 0)" required>
                                <span class="ml-2 text-gray-700">No</span>
                            </label>
                        </div>
                    </div>

                    <!-- Continuous Statements -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-infinity text-orange-500 mr-2"></i> Continuous Statements
                        </label>
                        <div class="p-3 border border-gray-200 rounded-xl">
                            <label class="flex items-center cursor-pointer">
                                <input type="checkbox" id="continuous" name="Continuous" value="true" class="w-4 h-4 text-orange-500 focus:ring-orange-200" checked="@(Model?.Frequency?.Continuous == true)">
                                <span class="ml-3 text-gray-700">Enable Continuous Statements</span>
                            </label>
                        </div>
                    </div>

                    <!-- Daily Option -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-clock text-orange-500 mr-2"></i> Daily Option
                        </label>
                        <input type="number" id="dailyOpt" name="DailyOpt"
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                               value="@(Model?.Frequency?.DailyOpt ?? -1)" min="-1" required>
                    </div>

                    <!-- Weekly Option -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-clock text-orange-500 mr-2"></i> Weekly Option
                        </label>
                        <input type="number" id="weeklyOpt" name="WeeklyOpt"
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                               value="@(Model?.Frequency?.WeeklyOpt ?? -1)" min="-1" required>
                    </div>

                    <!-- Monthly Option -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-clock text-orange-500 mr-2"></i> Monthly Option
                        </label>
                        <input type="number" id="monthlyOpt" name="MonthlyOpt"
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                               value="@(Model?.Frequency?.MonthlyOpt ?? -1)" min="-1" required>
                    </div>

                    <!-- Continuous Option -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2 flex items-center">
                            <i class="fas fa-clock text-orange-500 mr-2"></i> Continuous Option
                        </label>
                        <input type="number" id="continuousOpt" name="ContinuousOpt"
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all"
                               value="@(Model?.Frequency?.ContinuousOpt ?? -1)" min="-1" required>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="mt-8 flex justify-center">
                    <button type="submit"
                            class="gt-orange-bg text-white px-12 py-3.5 rounded-xl font-semibold hover:bg-orange-600 transition-all flex items-center gap-3 min-w-[200px] justify-center shadow-lg hover:shadow-orange-200/50">
                        <span class="button-text"><i class="fas fa-save mr-2"></i> Update Customer</span>
                        <span class="button-loader hidden"><i class="fas fa-spinner fa-spin"></i> Updating...</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Success Modal -->
<div id="successModal" class="modal">
    <div class="modal-content">
        <div class="p-6 border-b flex justify-between items-center">
            <h3 class="text-xl font-semibold text-green-600 flex items-center">
                <i class="fas fa-check-circle mr-2"></i> Success!
            </h3>
            <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
        </div>
        <div class="p-6">
            <p id="modalMessage" class="text-gray-700">Customer information updated successfully.</p>
        </div>
        <div class="p-6 border-t flex justify-end">
            <button class="close-modal px-6 py-3 gt-orange-bg text-white rounded-xl font-semibold hover:bg-orange-600 transition">
                Close
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var newCustomerUrl = '@Url.Action("NewCustomer", "Profile")';
        var updateCustomerUrl = '@Url.Action("UpdateCustomer", "Profile")';
        var searchCustomersUrl = '@Url.Action("SearchCustomers", "Profile")';
        var profileUrls = {
            updateCustomer: '@Url.Action("UpdateCustomer", "Profile")',
            updateCustomerPost: '@Url.Action("UpdateCustomer", "Profile")'
        };
        @if (Model?.CIF_ID != null)
        {
        <text>
        $('#formSection').show();
        bindFormEvents();
        </text>
        }
    </script>
    <script src="~/js/update_customer.js" type="text/javascript"></script>
}