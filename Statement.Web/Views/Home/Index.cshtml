@{
    ViewData["Title"] = "Dashboard - GT Bank Ghana";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GT Bank Ghana :: Statement Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

    <style>
        .gt-orange {
        color: #F97316;
        }

        .gt-orange-bg {
        background-color: #F97316;
        }

        .gt-orange-hover:hover {
        background-color: #EA580C;
        }

        .modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.7);
        align-items: center;
        justify-content: center;
        z-index: 1000;
        }

        .modal-content {
        background: white;
        border-radius: 16px;
        width: 90%;
        max-width: 520px;
        max-height: 90vh;
        overflow-y: auto;
        }

        /* Fix for footer positioning */
        html, body {
        height: 100%;
        margin: 0;
        }

        body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        }

        .main-content {
        flex: 1 0 auto;
        }

        footer {
        flex-shrink: 0;
        }
    </style>
</head>
<body class="bg-gray-50">

    @Html.AntiForgeryToken()

    <!-- Top Navigation -->
    <nav class="bg-white border-b sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
            <div class="flex items-center gap-4">
                <img src="~/Resources/glogo.jpg" alt="GT Bank" class="h-10 w-10 rounded-full">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800">GT Bank Ghana</h1>
                    <p class="text-xs text-gray-500">Statement By Email Portal</p>
                </div>
            </div>
            <div class="flex items-center gap-8 text-sm font-medium">
                <a href="#" class="text-gray-700 hover:text-orange-500 transition">Dashboard</a>
                <a href="/Profile/Index" class="text-gray-700 hover:text-orange-500 transition">Profile</a>
                <a href="/Account/Logout" class="flex items-center gap-2 text-red-600 hover:text-red-700 transition">
                    <i class="fas fa-sign-out-alt"></i> Logout
                </a>
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.WelcomeMessage))
            {
                <div class="bg-orange-50 border-l-4 border-orange-500 p-4 mb-8 rounded-r-lg">
                    <div class="flex items-center">
                        <i class="fas fa-hand-wave text-orange-500 text-2xl mr-3"></i>
                        <span class="text-gray-800 font-medium">@ViewBag.WelcomeMessage</span>
                    </div>
                </div>
            }
        </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content">
        <div class="max-w-7xl mx-auto px-6 py-10">
            <h2 class="text-3xl font-semibold text-gray-800 mb-2">Customer Statements Portal</h2>
            <p class="text-gray-600 mb-10">Search and manage financial statements</p>

            <!-- Search Form -->
            <div class="bg-white rounded-3xl shadow p-8 mb-12">
                <form id="searchForm" class="grid grid-cols-1 md:grid-cols-12 gap-6">
                    <div class="md:col-span-3">
                        <label class="block text-sm font-medium text-gray-600 mb-2">Search Parameter</label>
                        <select id="SearchParameter" name="SearchParameter" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all">
                            <option value="CIF_ID">CIF ID</option>
                            <option value="AccountNumber">Account Number</option>
                        </select>
                    </div>
                    <div class="md:col-span-3">
                        <label class="block text-sm font-medium text-gray-600 mb-2">Search Value</label>
                        <input type="text" id="SearchValue" name="SearchValue" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all" placeholder="Enter CIF or Account" required>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-600 mb-2">Start Date</label>
                        <input type="text" id="StartDate" name="StartDate" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all" required>
                    </div>
                    <div class="md:col-span-2">
                        <label class="block text-sm font-medium text-gray-600 mb-2">End Date</label>
                        <input type="text" id="EndDate" name="EndDate" class="w-full px-4 py-3 border border-gray-300 rounded-2xl focus:border-orange-500 focus:ring-2 focus:ring-orange-200 transition-all" required>
                    </div>
                    <div class="md:col-span-2 flex items-end">
                        <button type="submit" id="searchBtn" class="w-full gt-orange-bg text-white py-3.5 rounded-2xl font-semibold hover:bg-orange-600 transition-all">
                            <span id="btn-text">Search</span>
                            <span id="btn-loader" class="hidden"><i class="fas fa-spinner fa-spin"></i></span>
                        </button>
                    </div>
                </form>
                <div id="searchError" class="hidden mt-4 p-4 bg-red-50 text-red-600 rounded-2xl"></div>
            </div>

            <!-- Results -->
            <div id="resultsSection" class="hidden">
                <div class="flex justify-between items-center mb-6">
                    <h3 class="text-2xl font-semibold">Search Results</h3>
                    <div class="flex gap-4">
                        <button id="downloadPdfBtn" class="px-6 py-3 border border-orange-500 text-orange-600 rounded-2xl hover:bg-orange-50 transition">PDF</button>
                        <button id="downloadExcelBtn" class="px-6 py-3 border border-orange-500 text-orange-600 rounded-2xl hover:bg-orange-50 transition">Excel</button>
                        <button id="emailBtn" class="gt-orange-bg text-white px-6 py-3 rounded-2xl hover:bg-orange-600 transition">Email</button>
                    </div>
                </div>

                <div class="bg-white rounded-3xl shadow overflow-hidden">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Account Number</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Name</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Email</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Balance</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-600">Currency</th>
                            </tr>
                        </thead>
                        <tbody id="customerTable" class="divide-y divide-gray-100"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- PDF Modal: select accounts to download -->
    <div id="pdfModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b flex justify-between">
                <h3 class="text-xl font-semibold">Select Accounts for PDF</h3>
                <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
            </div>
            <div class="p-6 max-h-96 overflow-auto">
                <table class="w-full" id="pdfTable">
                    <thead><tr class="bg-gray-50"><th><input type="checkbox" id="selectAllPdf" class="w-4 h-4 text-orange-500"></th><th class="text-left">Account</th><th class="text-left">Name</th><th class="text-left">Balance</th><th class="text-left">Currency</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="p-6 border-t flex gap-3">
                <button id="downloadSelectedPdf" class="flex-1 py-3 bg-gray-200 rounded-2xl disabled:opacity-50 hover:bg-gray-300 transition">Selected</button>
                <button id="downloadAllPdf" class="flex-1 py-3 gt-orange-bg text-white rounded-2xl hover:bg-orange-600 transition">All Accounts</button>
            </div>
        </div>
    </div>

    <!-- Pricing / Charge Confirmation Modal -->
    <div id="chargeConfirmModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b flex justify-between">
                <h3 class="text-xl font-semibold">Confirm Statement Charge</h3>
                <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
            </div>
            <div class="p-6 space-y-3 text-gray-700">
                <p>You are about to generate a statement for <strong><span id="chargeAccountCount">0</span></strong> account(s), covering <strong><span id="chargePeriod"></span></strong>.</p>
                <p>Estimated charge: <strong><span id="chargeAmount">&mdash;</span></strong> cedis for <strong><span id="pageCount">&mdash;</span></strong> page(s).</p>
                <p class="text-sm text-gray-500">Standard statement fees apply per the bank's tariff. Do you want to proceed?</p>
            </div>
            <div class="p-6 border-t flex gap-3">
                <button id="cancelChargeBtn" class="close-modal flex-1 py-3 bg-gray-200 rounded-2xl hover:bg-gray-300 transition">Cancel</button>
                <button id="confirmChargeBtn" class="flex-1 py-3 gt-orange-bg text-white rounded-2xl hover:bg-orange-600 transition">Proceed</button>
            </div>
        </div>
    </div>

    <!-- Excel Modal: select accounts to download -->
    <div id="excelModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b flex justify-between">
                <h3 class="text-xl font-semibold">Select Accounts for Excel</h3>
                <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
            </div>
            <div class="p-6 max-h-96 overflow-auto">
                <table class="w-full" id="excelTable">
                    <thead><tr class="bg-gray-50"><th><input type="checkbox" id="selectAllExcel" class="w-4 h-4 text-orange-500"></th><th class="text-left">Account</th><th class="text-left">Name</th><th class="text-left">Balance</th><th class="text-left">Currency</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="p-6 border-t flex gap-3">
                <button id="downloadSelectedExcel" class="flex-1 py-3 bg-gray-200 rounded-2xl disabled:opacity-50 hover:bg-gray-300 transition">Selected</button>
                <button id="downloadAllExcel" class="flex-1 py-3 gt-orange-bg text-white rounded-2xl hover:bg-orange-600 transition">All Accounts</button>
            </div>
        </div>
    </div>

    <!-- Email Modal -->
    <div id="emailModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b flex justify-between">
                <h3 class="text-xl font-semibold">Email Statement</h3>
                <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
            </div>
            <div class="p-6">
                <table class="w-full" id="emailTable">
                    <thead><tr class="bg-gray-50"><th><input type="checkbox" id="selectAllEmail" class="w-4 h-4 text-orange-500"></th><th class="text-left">Account</th><th class="text-left">Name</th><th class="text-left">Currency</th></tr></thead>
                    <tbody></tbody>
                </table>
            </div>
            <div class="p-6 border-t flex gap-3">
                <button id="emailSelectedBtn" class="flex-1 py-3 bg-gray-200 rounded-2xl disabled:opacity-50 hover:bg-gray-300 transition">Selected</button>
                <button id="emailAllBtn" class="flex-1 py-3 gt-orange-bg text-white rounded-2xl hover:bg-orange-600 transition">All Accounts</button>
            </div>
        </div>
    </div>

    <!-- Success Modal -->
    <div id="successModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b flex justify-between items-center">
                <h3 class="text-xl font-semibold text-green-600"><i class="fa fa-check-circle mr-2"></i>Success</h3>
                <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
            </div>
            <div class="p-6">
                <p id="successMessage" class="text-gray-700"></p>
            </div>
            <div class="p-6 border-t flex justify-end">
                <button class="close-modal px-6 py-3 gt-orange-bg text-white rounded-2xl hover:bg-orange-600 transition">Close</button>
            </div>
        </div>
    </div>

    <!-- Error Modal -->
    <div id="errorModal" class="modal">
        <div class="modal-content">
            <div class="p-6 border-b flex justify-between items-center">
                <h3 class="text-xl font-semibold text-red-600"><i class="fa fa-exclamation-circle mr-2"></i>Notice</h3>
                <button class="close-modal text-3xl text-gray-400 hover:text-gray-600 transition">&times;</button>
            </div>
            <div class="p-6">
                <p id="errorMessage" class="text-gray-700"></p>
            </div>
            <div class="p-6 border-t flex justify-end">
                <button class="close-modal px-6 py-3 bg-gray-200 rounded-2xl hover:bg-gray-300 transition">Close</button>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-white border-t">
        <div class="max-w-7xl mx-auto px-6 py-6 text-center text-sm text-gray-500">
            <p>&copy; @DateTime.Now.Year GT Bank (Ghana) Limited - GT Bank Technology. All rights reserved.</p>
        </div>
    </footer>

    <script src="~/js/site.js" type="text/javascript"></script>
</body>
</html>