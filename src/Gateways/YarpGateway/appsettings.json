{
  "AllowedHosts": "*",
  "SerilogOptions": {
    "WriteToFile": true,
    "StructuredConsoleLogging": false
  },
  "SwaggerOptions": {
    "Title": "My API",
    "Description": "A description of my API",
    "Name": "Your Name",
    "Email": "yourname@example.com"
  },
  "AppOptions": {
    "Name": "Gateway"
  },
  "CachingOptions": {
    "EnableDistributedCaching": false,
    "SlidingExpirationInMinutes": 5,
    "AbsoluteExpirationInMinutes": 10
  },
  "OpenIdOptions": {
    "Authority": "https://localhost:7001/",
    "Audience": "gateway.resource.server"
  },
  "ReverseProxy": {
    "routes": {
      "customer": {
        "clusterId": "customer",
        "match": {
          "path": "/api/v1/customers/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "loan": {
        "clusterId": "loan",
        "match": {
          "path": "/api/v1/loans/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "account": {
        "clusterId": "account",
        "match": {
          "path": "/api/v1/accounts/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "transaction": {
        "clusterId": "transaction",
        "match": {
          "path": "/api/v1/transactions/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "branch": {
        "clusterId": "branch",
        "match": {
          "path": "/api/v1/branches/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "identity": {
        "clusterId": "identity",
        "match": {
          "path": "/api/identity/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "clusters": {
      "customer": {
        "destinations": {
          "customer": {
            "address": "http://localhost:81/api/v1/customers",
            "Swaggers": [
              {
                "PrefixPath": "/customers",
                "Paths": [ "/swagger/v1/swagger.json" ]
              }
            ]
          }
        }
      },
      "account": {
        "destinations": {
          "account": {
            "address": "http://localhost:82/api/v1/accounts",
            "Swaggers": [
              {
                "PrefixPath": "/accounts",
                "Paths": [ "/swagger/v1/swagger.json" ]
              }
            ]
          }
        }
      },
      "transaction": {
        "destinations": {
          "transaction": {
            "address": "http://localhost:83/api/v1/transactions",
            "Swaggers": [
              {
                "PrefixPath": "/transactions",
                "Paths": [ "/swagger/v1/swagger.json" ]
              }
            ]
          }
        }
      },
      "branch": {
        "destinations": {
          "branch": {
            "address": "http://localhost:84/api/v1/branches"
          }
        }
      },
      "loan": {
        "destinations": {
          "loan": {
            "address": "http://localhost:86/api/v1/loans"
          }
        }
      },
      "identity": {
        "destinations": {
          "identity": {
            "address": "https://localhost:7001"
          }
        }
      }
    }
  },
  "ElasticConfiguration": {
    "Uri": "http://10.61.222.49:9200" // Replace with your Elasticsearch URI
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Elasticsearch", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://10.61.222.49:9200", // Replace with your Elasticsearch URI
          "indexFormat": "gateway-logs-{0:yyyy.MM}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv7",
          "customFormatter": "Serilog.Formatting.Elasticsearch.ElasticsearchJsonFormatter, Serilog.Formatting.Elasticsearch"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "Properties": {
      "Application": "YarpGateway"
    }
  }
}

