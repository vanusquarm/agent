{
  "AllowedHosts": "*",
  "SerilogOptions": {
    "WriteToFile": true,
    "StructuredConsoleLogging": false
  },
  "AppOptions": {
    "Name": "Gateway"
  },
  "CachingOptions": {
    "EnableDistributedCaching": false,
    "SlidingExpirationInMinutes": 5,
    "AbsoluteExpirationInMinutes": 10
  },
  "OpenIdOptions": {
    "Authority": "https://localhost:7001/",
    "Audience": "gateway.resource.server"
  },
  "ReverseProxy": {
    "routes": {
      "todo": {
        "clusterId": "todo",
        "match": {
          "path": "/api/todo/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "identity": {
        "clusterId": "identity",
        "match": {
          "path": "/api/identity/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "clusters": {
      "todo": {
        "destinations": {
          "todo": {
            "address": "https://localhost:44328/"
          }
        }
      },
      "identity": {
        "destinations": {
          "identity": {
            "address": "https://localhost:7001"
          }
        }
      }
    }
  }
}
