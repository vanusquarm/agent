{
  "AllowedHosts": "*",
  "SerilogOptions": {
    "WriteToFile": true,
    "StructuredConsoleLogging": false
  },
  "SwaggerOptions": {
    "Title": "My API",
    "Description": "A description of my API",
    "Name": "Your Name",
    "Email": "yourname@example.com"
  },
  "AppOptions": {
    "Name": "Gateway"
  },
  "CachingOptions": {
    "EnableDistributedCaching": false,
    "SlidingExpirationInMinutes": 5,
    "AbsoluteExpirationInMinutes": 10
  },
  "OpenIdOptions": {
    "Authority": "https://localhost:7001/",
    "Audience": "gateway.resource.server"
  },
  "ReverseProxy": {
    "routes": {
      "customer": {
        "clusterId": "customer",
        "match": {
          "path": "/api/v1/customers/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "loan": {
        "clusterId": "loan",
        "match": {
          "path": "/api/v1/loans/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "account": {
        "clusterId": "account",
        "match": {
          "path": "/api/v1/accounts/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "transaction": {
        "clusterId": "transaction",
        "match": {
          "path": "/api/v1/transactions/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "branch": {
        "clusterId": "branch",
        "match": {
          "path": "/api/v1/branches/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "loan": {
        "clusterId": "loan",
        "match": {
          "path": "/api/v1/loans/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      },
      "identity": {
        "clusterId": "identity",
        "match": {
          "path": "/api/identity/{**catch-all}"
        },
        "transforms": [
          {
            "pathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "clusters": {
      "customer": {
        "destinations": {
          "customer": {
            "address": "http://localhost:5049/api/v1/customers"
          }
        }
      },
      "loan": {
        "destinations": {
          "loan": {
            "address": "http://localhost:5009/api/v1/loans"
          }
        }
      },
      "account": {
        "destinations": {
          "account": {
            "address": "http://localhost:82/api/v1/accounts"
          }
        }
      },
      "transaction": {
        "destinations": {
          "transaction": {
            "address": "http://localhost:83/api/v1/transactions"
          }
        }
      },
      "branch": {
        "destinations": {
          "branch": {
            "address": "http://localhost:84/api/v1/branches"
          }
        }
      },
      "loan": {
        "destinations": {
          "loan": {
            "address": "http://10.61.220.95:86/api/v1/loans"
          }
        }
      },
      "identity": {
        "destinations": {
          "identity": {
            "address": "https://localhost:7001"
          }
        }
      }
    }
  }
}
