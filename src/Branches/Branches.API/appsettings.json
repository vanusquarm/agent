{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Overide": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Fatal",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\Branches\\BranchesTextLogs_.json",
          "fileSizeLimitBytes": "1000000",
          "rollingInterval": "Day",
          "retainedFileCountLimit": "100",
          "rollOnFileSizeLimit": "true",
          "shared": "true",
          "flushToDiskInterval": "00:00:01"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\Branches\\BranchesStructuredLogs_.json",
          "fileSizeLimitBytes": "1000000",
          "rollingInterval": "Day",
          "retainedFileCountLimit": "100",
          "rollOnFileSizeLimit": "true",
          "shared": "true",
          "flushToDiskInterval": "00:00:01",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" },
        "apiKey": "v34Fy6d7zSgNO47LY9QB"
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

  "BaseUrl": "https://apihubdev.gtbghana.com/api",
  "JwtSettings": {
    "Authority": "https://your-authority-url.com",
    "Audience": "your-audience",
    "ClientId": "APIHUB",
    "ClientSecret": "vF8L4h2eEu/ywruKMR9keWQ+JibUqdYcHFRL6vRGI6vJyvXQWbuGwS5XvAGl868I",
    "IssuerUrl": "https://coredev.gtbghana.com/fininfra/token",
    "SecretKey": "your-secret-key",
    "AccessToken": "",
    "Subject": "gateway"
  }
}
