{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;10.61.222.95;10.61.88.61",
  "CorsOptions": {
    "AllowedOrigins": [
      "http://10.61.222.95:5005",
      "http://10.61.88.61:5005"
    ]
  },
  "OpenIdOptions": {
    "Authority": "https://keycloaktestgm.gtbank.com:8443/realms/finacle/protocol/openid-connect/token",
    "Audience": "gateway.resource.server"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Overide": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Fatal",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "C:\\Logs\\Loans\\LoansStructuredLogs_.json",
          "fileSizeLimitBytes": "1000000",
          "rollingInterval": "Day",
          "retainedFileCountLimit": "100",
          "rollOnFileSizeLimit": "true",
          "shared": "true",
          "flushToDiskInterval": "00:00:01",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "Elasticsearch",
        "Args": {
          "nodeUris": "http://10.61.222.49:9200", // Replace with your Elasticsearch URI
          "indexFormat": "gateway-logs-{0:yyyy.MM}",
          "autoRegisterTemplate": true,
          "autoRegisterTemplateVersion": "ESv7",
          "customFormatter": "Serilog.Formatting.Elasticsearch.ElasticsearchJsonFormatter, Serilog.Formatting.Elasticsearch"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },

